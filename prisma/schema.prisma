generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum audiencia {
  HOMBRE
  MUJER
  AMBOS
}

model categorias {
  id              BigInt          @id(map: "categoria_pkey") @default(autoincrement())
  nombre          String
  slug            String          @unique(map: "categoria_slug_key")
  image_url       String?
  image_public_id String?
  active          Boolean         @default(true)
  sort_order      Int             @default(0)
  subcategorias   subcategorias[]

  @@index([active, sort_order, id], map: "idx_categorias_active_sort")
}

model subcategorias {
  id           BigInt      @id @default(autoincrement())
  categoria_id BigInt
  nombre       String
  slug         String
  audiencia    audiencia   @default(AMBOS)
  active       Boolean     @default(true)
  sort_order   Int         @default(0)
  created_at   DateTime    @default(now()) @db.Timestamptz(6)
  updated_at   DateTime    @default(now()) @db.Timestamptz(6)
  categorias   categorias  @relation(fields: [categoria_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  productos    productos[]

  @@unique([categoria_id, slug], map: "uq_subcategorias_categoria_slug")
  @@index([categoria_id], map: "idx_subcategorias_categoria")
  @@index([active, sort_order, id], map: "idx_subcategorias_active_sort")
  @@index([audiencia], map: "idx_subcategorias_audiencia")
}

model orden_productos {
  id                      BigInt          @id @default(autoincrement())
  order_id                BigInt
  product_variant_size_id BigInt
  cantidad                Int
  precio_unidad           Int
  created_at              DateTime        @default(now()) @db.Timestamptz(6)
  ordenes                 ordenes         @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variante_talles         variante_talles @relation(fields: [product_variant_size_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([order_id], map: "idx_orden_productos_order")
  @@index([product_variant_size_id], map: "idx_orden_productos_sku")
}

model ordenes {
  id               BigInt            @id @default(autoincrement())
  numero_orden     Int               @unique @default(dbgenerated("generate_order_number()"))
  user_id          BigInt?
  customer_name    String
  customer_phone   String
  customer_email   String
  delivery_method  String
  shipping_address String?
  status           String            @default("PENDING")
  payment_method   String            @default("TRANSFER")
  total            Int               @default(0)
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  orden_productos  orden_productos[]
  usuarios         usuarios?         @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([status], map: "idx_ordenes_status")
  @@index([user_id], map: "idx_ordenes_user")
}

model productos {
  id                    BigInt                  @id @default(autoincrement())
  nombre                String
  slug                  String                  @unique
  descripcion           String?
  subcategoria_id       BigInt
  genero                audiencia               @default(AMBOS)
  precio                Int
  active                Boolean                 @default(true)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  update_at             DateTime                @default(now()) @db.Timestamptz(6)
  subcategorias         subcategorias           @relation(fields: [subcategoria_id], references: [id], onUpdate: NoAction)
  home_product_sections home_product_sections[]
  variantes             variantes[]

  @@index([subcategoria_id], map: "idx_productos_subcategoria")
  @@index([genero], map: "idx_productos_genero")
}

model usuarios {
  id            BigInt    @id @default(autoincrement())
  email         String    @unique
  password_hash String
  role          String    @default("CUSTOMER")
  name          String
  phone         String
  direccion     String?
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  ordenes       ordenes[]
}

model home_product_sections {
  id         BigInt    @id @default(autoincrement())
  product_id BigInt
  section    String
  sort_order Int       @default(0)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @db.Timestamptz(6)
  productos  productos @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([product_id, section], map: "uq_home_product_sections_product_section")
  @@index([product_id], map: "idx_home_product_sections_product")
  @@index([section, sort_order, id], map: "idx_home_product_sections_section_sort")
}

model ImagenPortada {
  id              Int     @id @default(autoincrement())
  desktopUrl      String  @map("desktop_url")
  mobileUrl       String  @map("mobile_url")
  desktopPublicId String? @map("desktop_public_id")
  mobilePublicId  String? @map("mobile_public_id")
  href            String?
  sortOrder       Int     @default(0) @map("sort_order")

  @@index([sortOrder, id], map: "idx_imagenes_portada_sort")
  @@map("imagenes_portada")
}

model variante_imagenes {
  id         BigInt    @id @default(autoincrement())
  variant_id BigInt
  url        String
  public_id  String?
  alt        String?
  sort_order Int       @default(0)
  variantes  variantes @relation(fields: [variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([variant_id], map: "idx_variante_imagenes_variant")
}

model variante_talles {
  id              BigInt            @id @default(autoincrement())
  variant_id      BigInt
  talle           String
  stock           Int               @default(0)
  orden_productos orden_productos[]
  variantes       variantes         @relation(fields: [variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([variant_id, talle], map: "uq_variante_talles")
  @@index([variant_id], map: "idx_variante_talles_variant")
}

model variantes {
  id           BigInt  @id @default(autoincrement())
  product_id   BigInt
  nombre_color String
  color_hex    String?
  active       Boolean @default(true)

  // ✅ NUEVO
  sort_order Int @default(0)

  variante_imagenes variante_imagenes[]
  variante_talles   variante_talles[]
  productos         productos           @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([product_id, nombre_color], map: "uq_variantes_producto_color")
  @@index([product_id], map: "idx_variantes_producto")
  // (para ordenar rápido por producto)
  @@index([product_id, sort_order, id], map: "idx_variantes_producto_sort")
}
