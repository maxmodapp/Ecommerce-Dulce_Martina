-- 5) Imágenes por variante (URLs placeholder)
-- Usamos picsum con seeds para que cambie por color y producto
insert into variante_imagenes (variant_id, url, alt, sort_order)
select v.id,
       'https://picsum.photos/seed/' || p.slug || '-' || lower(replace(v.nombre_color,' ','-')) || '/900/1200',
       p.nombre || ' - ' || v.nombre_color,
       0
from variantes v
join productos p on p.id = v.product_id;

-- Agregar una segunda imagen por variante (para simular galería)
insert into variante_imagenes (variant_id, url, alt, sort_order)
select v.id,
       'https://picsum.photos/seed/' || p.slug || '-' || lower(replace(v.nombre_color,' ','-')) || '-2/900/1200',
       p.nombre || ' - ' || v.nombre_color || ' (2)',
       1
from variantes v
join productos p on p.id = v.product_id;

